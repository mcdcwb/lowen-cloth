generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model StoreSettings {
  id                Int @id @default(1)
  lowStockThreshold Int @default(5)
}

model Product {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  price       Decimal

  public      String
  category    String

  badge       String?
  inCarousel  Boolean @default(false)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  colors ProductColor[]
  favorites Favorite[]
}

model ProductColor {
  id Int @id @default(autoincrement())
  productId Int
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  colorName String
  colorValue String
  imageUrl String?
  images String[]
  position Int @default(0)
  variants ProductVariant[]
  @@index([productId])
}

model ProductVariant {
  id Int @id @default(autoincrement())
  value String
  stock Int @default(0)
  colorId Int
  color ProductColor @relation(fields: [colorId], references: [id], onDelete: Cascade)
  cartItems CartItem[]
  @@unique([colorId, value])
}

model Admin {
  id Int @id @default(autoincrement())
  email String @unique
  passwordHash String
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  address UserAddress?
  favorites Favorite[]
  cartItems CartItem[]
  id Int @id @default(autoincrement())
  name String
  email String @unique
  passwordHash String
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserAddress {
  userId Int @id
  cep String
  street String
  number String
  complement String @default("")
  neighborhood String
  city String
  state String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Favorite {
  userId Int
  productId Int
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  @@id([userId, productId])
  @@index([productId])
}

model CartItem {
  userId Int
  variantId Int
  quantity Int
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  @@id([userId, variantId])
  @@index([variantId])
}
